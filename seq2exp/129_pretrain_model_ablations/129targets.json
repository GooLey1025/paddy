{
    "train": {
        "batch_size": 128,
        "shuffle_buffer": 256,
        "optimizer": "adam",
        "learning_rate": 0.0002,
        "loss": "poisson_mn",
        "total_weight": 0.2,
        "weight_range": 8,
        "weight_exp": 6,
        "warmup_steps": 1000,
        "global_clipnorm": 0.2,
        "adam_beta1": 0.9,
        "adam_beta2": 0.999,
        "patience": 30,
        "train_epochs_min": 1,
        "train_epochs_max": 500,
        "num_gpu": 2
    },
    "model": {
        "seq_length": 32768,
        "augment_rc": true,
        "augment_shift": 3,
        "activation": "gelu",
        "norm_type": "batch",
        "bn_momentum": 0.9,
        "kernel_initializer": "lecun_normal",
        "l2_scale": 1.0e-6,
        "trunk": [
            {
                "name": "conv_dna",
                "filters": 128,
                "kernel_size": 11,
                "norm_type": null,
                "activation": "linear",
                "pool_size": 2
            },
            {
                "name": "res_tower",
                "filters_init": 256,
                "filters_end": 512,
                "divisible_by": 32,
                "kernel_size": 10,
                "num_convs": 1,
                "pool_size": 2,
                "repeat": 6
            },
            {
                "name": "transformer",
                "key_size": 64,
                "heads": 8,
                "num_position_features": 1024,
                "dropout": 0,
                "attention_dropout": 0,
                "mha_l2_scale": 0,
                "kernel_initializer": "he_normal",
                "dense_expansion": 0
            },
            {
                "name": "unet_conv",
                "kernel_size": 3,
                "upsample_conv": "True"
            },
            {
                "name": "unet_conv",
                "kernel_size": 3,
                "upsample_conv": "True"
            }
        ],
        "head_rice_marks": {
            "name": "final",
            "units": 129,
            "activation": "softplus"
        }
    }
}
